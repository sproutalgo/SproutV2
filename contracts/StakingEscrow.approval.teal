// staking_escrow.StakingEscrow.get_surplus[routing]() -> void:
get_surplus:
    // staking_escrow.py:430-432
    // # Mirrors harvest's floor exactly (principal + mbr + buffer) so the UI
    // # never shows harvestable surplus that harvest would refuse.
    // app_bal = Global.current_application_address.balance
    global CurrentApplicationAddress
    acct_params_get AcctBalance
    swap
    dup
    uncover 2
    assert // account funded
    // staking_escrow.py:433
    // floor = self._harvest_floor()
    callsub _harvest_floor
    dup
    cover 2
    // staking_escrow.py:434
    // if app_bal <= floor:
    <=
    bz get_surplus_after_if_else@3
    popn 2
    // staking_escrow.py:435
    // return UInt64(0)
    intc_0 // 0

get_surplus_after_inlined_staking_escrow.StakingEscrow.get_surplus@4:
    // staking_escrow.py:428
    // @abimethod(readonly=True)
    itob
    bytec_1 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return

get_surplus_after_if_else@3:
    // staking_escrow.py:436
    // return app_bal - floor
    -
    // staking_escrow.py:428
    // @abimethod(readonly=True)
    b get_surplus_after_inlined_staking_escrow.StakingEscrow.get_surplus@4


