    dup
    itxn_field CloseRemainderTo
    // staking_escrow.py:462
    // amount=0,
    intc_0 // 0
    itxn_field Amount
    itxn_field Receiver
    // staking_escrow.py:457-460
    // # 2) Close the app account: send ALL remaining ALGO to admin and zero the
    // # account. amount=0 + close_remainder_to moves the entire balance (less fee)
    // # to the admin in one step.
    // itxn.Payment(
    intc_1 // pay
    itxn_field TypeEnum
    // staking_escrow.py:464
    // fee=0,
    intc_0 // 0
    itxn_field Fee
    // staking_escrow.py:457-465
    // # 2) Close the app account: send ALL remaining ALGO to admin and zero the
